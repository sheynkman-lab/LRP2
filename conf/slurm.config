/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for process SLURM HPC cluster options on ne1
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor = 'slurm'
    queue = 'cpu'
    clusterOptions = ''

    withLabel:process_single {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
        queue  = 'cpu'
    }
    withLabel:process_low {
        cpus   = 2
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
        queue  = 'cpu'
    }
    withLabel:process_medium {
        cpus   = 6
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
        queue  = 'cpu'
    }
    withLabel:process_high {
        cpus   = 12
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
        queue  = 'cpu'
    }
}

singularity {
    enabled = true
    autoMounts = true
    pullTimeout = '120 min'
    // You can specify a cache directory here for use in HPC environments to avoid re-converting containers on each run, e.g.
    //cacheDir = '/my/dir/singularity_cache'
}

