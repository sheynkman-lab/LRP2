/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: PBTK_PBMERGE {
        publishDir = [
            path: { "${params.outdir}/01_pacbio_isoseq/isoseq_merge" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: ISOSEQ_CLUSTER {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/01_pacbio_isoseq/isoseq_cluster" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: ISOSEQ_ALIGN {
        publishDir = [
            path: { "${params.outdir}/01_pacbio_isoseq/isoseq_align" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: ISOSEQ_COLLAPSE {
        ext.args = '--do-not-collapse-extra-5exons'
        ext.max_fuzzy_junction = params.max_fuzzy_junction
        ext.max_5p_diff = params.max_5p_diff
        ext.max_3p_diff = params.max_3p_diff
        publishDir = [
            path: { "${params.outdir}/01_pacbio_isoseq/isoseq_collapse" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SQANTI_QC {
        publishDir = [
            path: { "${params.outdir}/02_transcriptome/sqanti_qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: FILTER_TRANSCRIPTOME {
        ext.protein_coding_filter = params.protein_coding_filter
        ext.internal_priming_filter = params.internal_priming_filter
        ext.template_switching_filter = params.template_switching_filter
        ext.percent_polya_threshold = params.percent_polya_threshold
        ext.structure_filter = params.structure_filter
        publishDir = [
            path: { "${params.outdir}/02_transcriptome/filter_transcriptome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CPAT_ORF {
        ext.min_orf = params.min_orf
        ext.top_orf = params.top_orf
        publishDir = [
            path: { "${params.outdir}/03_predicted_proteome/cpat_orf" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: FILTER_CPAT {
        ext.cpat_coding_threshold = params.cpat_coding_threshold ?: (params.species == 'human' ? 0.364 : 0.44)
        publishDir = [
            path: { "${params.outdir}/03_predicted_proteome/filter_cpat" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SQANTI_PROTEIN_CLASSIFICATION {
        publishDir = [
            path: { "${params.outdir}/03_predicted_proteome/sqanti_protein" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: PROTEIN_UTR_CLASSIFICATION {
        ext.min_junctions_after_stop = params.min_junctions_after_stop_codon
        ext.protein_class_keep = params.protein_class_keep
        publishDir = [
            path: { "${params.outdir}/03_predicted_proteome/protein_utr_classification" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null
                } else if (filename.startsWith('protein_sqanti/')) {
                    return filename.replaceFirst('protein_sqanti/', '')
                } else {
                    return filename
                }
            }
        ]
    }

}

