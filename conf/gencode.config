/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Merge igenomes and GENCODE references, then auto-set params
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // Merge GENCODE references into params.genomes
    genomes = (params.genomes ?: [:]) + (params.gencode_refs ?: [:])

    // Priority execution:
    // (1) if local references are provided, use them (takes precedence)
    // (2) otherwise, use GENCODE references from --genome
    gtf = params.local_reference_gtf ?
        params.local_reference_gtf :
        (params.genomes && params.genome && params.genomes.containsKey(params.genome) ?
            params.genomes[params.genome].gtf :
            null)

    fasta = params.local_reference_fasta ?
        params.local_reference_fasta :
        (params.genomes && params.genome && params.genomes.containsKey(params.genome) ?
            params.genomes[params.genome].fasta :
            null)

    // Auto-detect species ONLY from predefined genome (from gencode_refs)
    // note: if user provides custom local references, they must manually set --species
    species = (params.local_reference_gtf && params.local_reference_fasta) ?
        params.species :
        (params.genomes && params.genome && params.genomes.containsKey(params.genome) ?
            (params.genome.startsWith('GRCm') ? 'mouse' : 'human') :
            params.species)
}
